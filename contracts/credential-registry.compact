pragma language_version >= 0.23;

import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// ConfiCred — Zero-Knowledge Credential Registry
//
// WHAT IS PUBLIC (visible to anyone on-chain):
//   - issuer: the field element identifying the credential issuer
//   - totalCredentials: how many credentials have been registered
//   - totalRevoked: how many registered credentials have been revoked
//   - credentials: map from a disclosed credential-ID (32-byte digest)
//     to its owner commitment — or to a status marker digest:
//       hash(secret)          → registered & active
//       pad(32, "suspended")  → suspended (temporarily invalid)
//       pad(32, "revoked")    → revoked (terminal)
//   - revoked: map from credential-ID to 1 (revoked) or 0 (not revoked),
//     so status is a flat lookup rather than a digest comparison.
//   - suspended: map from credential-ID to 1 (suspended) or 0, mirroring
//     the revoked flag for the temporary-invalidation lifecycle.
//
// WHAT IS PRIVATE (private witness, never on-chain):
//   - holderSecret: the credential holder's 32-byte secret, passed as a
//     circuit input and consumed only inside the ZK proof. It never
//     appears in ledger state.
//   - newHolderSecret: the replacement secret during rotation.
//
// WHAT THE USER PROVES WITHOUT REVEALING:
//   - Registration: that they know holderSecret — its hash is stored
//     on-chain as the owner commitment.
//   - Rotation: that they know the CURRENT holderSecret (knowledge of the
//     old secret is the access control, enforced against the on-chain
//     commitment inside the circuit) AND the hash of the replacement —
//     without revealing either secret.
//
// NOTE ON TYPES: persistentHash cannot hash Opaque values, so secrets are
// passed as fixed-size byte strings (Bytes<32>) rather than Opaque<"string">.
// ─────────────────────────────────────────────────────────────────────────────

export ledger issuer: Field;
export ledger totalCredentials: Field; // Field arithmetic wraps; no overflow edge cases.
export ledger totalRevoked: Field;
export ledger credentials: Map<Bytes<32>, Bytes<32>>;
export ledger revoked: Map<Bytes<32>, Field>;
export ledger suspended: Map<Bytes<32>, Field>;

// Status marker digests are defined inside the circuits that use them
// (this compiler version does not accept top-level const declarations):
//   pad(32, "revoked")    — terminal invalid state
//   pad(32, "suspended")  — temporary invalid state
//   pad(32, "active")     — reinstated active state

// registerCredential: enroll a new credential.
//
//   holderSecret  (PRIVATE witness) — the holder's 32-byte secret.
//   issuerId      (public via ledger write) — identifies the issuer.
//   credentialId  (public via ledger write) — 32-byte digest key under
//                 which the credential is registered.
//
// The stored value is persistentHash(holderSecret): proving ownership
// later requires knowing the secret, without ever putting the secret
// itself on-chain.
export circuit registerCredential(
    holderSecret: Bytes<32>,
    issuerId: Field,
    credentialId: Bytes<32>,
): [] {
    // Bind the (private) secret into a verifiable commitment. The hash is
    // public by intent (it's the on-chain commitment); the secret never is.
    const secretHash = persistentHash<Bytes<32>>(holderSecret);

    // Ledger writes: public state transitions. Circuit parameters are
    // witness data, so each write declares its disclosure explicitly.
    issuer = disclose(issuerId);
    totalCredentials = totalCredentials + 1;

    // Registered & active: commitment + explicit not-revoked / not-suspended flags.
    credentials.insert(disclose(credentialId), disclose(secretHash));
    revoked.insert(disclose(credentialId), disclose(0));
    suspended.insert(disclose(credentialId), disclose(0));
}

// revokeCredential: terminally invalidate a credential.
// Public, no witness required. Overwrites the owner commitment with the
// zero digest, flips the revoked flag, and bumps the public counter.
export circuit revokeCredential(credentialId: Bytes<32>): [] {
    const REVOKED_DIGEST: Bytes<32> = pad(32, "revoked");
    const id = disclose(credentialId);
    const alreadyRevoked = revoked.lookup(id);

    // Double-revocation must not double-count.
    if (alreadyRevoked == 0) {
        totalRevoked = totalRevoked + 1;
    }

    credentials.insert(id, REVOKED_DIGEST);
    revoked.insert(id, disclose(1));
    suspended.insert(id, disclose(0)); // revocation clears any suspension
}

// rotateCredential: replace a credential's holder secret.
//
//   holderSecret    (PRIVATE witness) — the CURRENT secret. Knowledge of it
//                   is the access control: the circuit asserts its hash
//                   matches the on-chain commitment before anything changes.
//   newHolderSecret (PRIVATE witness) — the replacement secret.
//   credentialId    (public) — which credential to rotate.
//
// Reveals nothing about either secret; only the new commitment lands
// on-chain. Compromise recovery and holder hand-off without re-issuing.
export circuit rotateCredential(
    holderSecret: Bytes<32>,
    newHolderSecret: Bytes<32>,
    credentialId: Bytes<32>,
): [] {
    const id = disclose(credentialId);
    const currentCommitment = credentials.lookup(id);
    const claimedCommitment = persistentHash<Bytes<32>>(holderSecret);

    // ZK access control: the rotation proceeds only when the caller
    // demonstrates knowledge of the current secret. The equality is
    // enforced inside the proof — a wrong secret fails the transaction.
    if (currentCommitment != claimedCommitment) {
        assert(currentCommitment == claimedCommitment, "rotation requires the current holder secret");
    }

    const newHash = persistentHash<Bytes<32>>(newHolderSecret);
    credentials.insert(id, disclose(newHash));
}

// suspendCredential: temporarily invalidate a credential (e.g. under
// investigation) without destroying it. Public, no witness required.
export circuit suspendCredential(credentialId: Bytes<32>): [] {
    const SUSPENDED_DIGEST: Bytes<32> = pad(32, "suspended");
    const id = disclose(credentialId);
    const alreadyRevoked = revoked.lookup(id);

    // Revocation is terminal: suspended credentials can be revoked, but
    // revoked credentials cannot be re-suspended. The writes below are a
    // no-op on already-revoked credentials.
    if (alreadyRevoked == 0) {
        credentials.insert(id, SUSPENDED_DIGEST);
        suspended.insert(id, disclose(1));
    }
}

// reinstateCredential: lift a suspension, restoring the credential to
// active status. Public, no witness required.
export circuit reinstateCredential(credentialId: Bytes<32>): [] {
    const id = disclose(credentialId);
    const isRevoked = revoked.lookup(id);
    const isSuspended = suspended.lookup(id);

    // Reinstate only makes sense on suspended (non-revoked) credentials;
    // on anything else this is a no-op.
    if (isRevoked == 0 && isSuspended == 1) {
        // The reinstated credential carries a neutral active marker: the
        // original holder secret is unknown to the chain (by design), so
        // the active state is represented by "not suspended, not revoked",
        // flagged via the maps, with a self-attesting digest.
        const ACTIVE_DIGEST: Bytes<32> = pad(32, "active");
        credentials.insert(id, ACTIVE_DIGEST);
        suspended.insert(id, disclose(0));
    }
}

// ─── Query circuits (off-chain verification support) ─────────────────────────
//
// Read-only: they change no ledger state. Their role is to produce a proof
// artifact for a specific query — the caller supplies the credential ID as a
// witness, it is bound into the proof via disclose(), and the dApp layer
// answers the question by reading the ledger at the disclosed ID. This keeps
// verifier flows provable without granting any write capability.

// Query: is this credential revoked?
export circuit isCredentialRevoked(credentialId: Bytes<32>): [] {
    disclose(credentialId);
}

// Query: is this credential suspended? (Distinct from revoked.)
export circuit isCredentialSuspended(credentialId: Bytes<32>): [] {
    disclose(credentialId);
}
